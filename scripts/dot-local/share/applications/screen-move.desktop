[Desktop Entry]
Name=Move Laptop Screen
Comment=Reposition the laptop monitor relative to the external screen
Exec=sh -c "$HOME/.local/bin/screen-move.sh"
Type=Application
Terminal=false
Keywords=monitor;display;sway;output;
#Icon=video-display
Icon=/usr/share/icons/Papirus-Dark/16x16/devices/video-display.svg
