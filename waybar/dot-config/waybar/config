{
    "height": 10,
    "spacing": 2,

    "modules-left": ["custom/launcher","sway/workspaces"],
    "modules-center": [],
    "modules-right": ["custom/recorder", "group/expandable-tray", "sway/mode", "network", "pulseaudio", "battery", "clock", "custom/power"],
    "custom/launcher": {
        "format": "🐧",
        "on-click": "wofi --show drun",
        "tooltip": "App Launcher"
    },
    "sway/workspaces": {
	    "disable-scroll": true,
	    "format": "{icon} {name}",
      "format-icons": {
        "urgent": "",
        "focused": "",
        "default": "⃝",
        "visible": "⦾"
	    }
    },

    // Define the expandable tray group
    "group/expandable-tray": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "click-to-reveal": true // Set to false if you prefer expanding on mouse hover
        },
        "modules": [
            "custom/arrow-next", // The first module acts as the toggle button
            "sway/language",
            "idle_inhibitor",
            "tray",               // Hidden inside the drawer
            "custom/timer"
        ]
    },

    // Define the toggle button appearance
    "custom/arrow-next": {
        "format": "  ", // Unicode arrow icon (e.g., FontAwesome, Nerd Fonts)
        "tooltip": false
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "custom/timer": {
      "exec": "~/.local/bin/waybar-timer.sh",
      "interval": 1,
      "on-click": "~/.local/bin/waybar-timer.sh set",
      "on-click-right": "~/.local/bin/waybar-timer.sh pause"
    },
    "sway/language": {
      "format": "{flag}",
      "on-click": "~/.local/bin/toggle-layout"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        "icon-size": 20,
        "spacing": 7
    },
    "clock": {
        "format": "{:%H:%M}",
    "tooltip-format": "<big>{:%A %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>",

    "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "weeks-pos": "right",
        "on-scroll": 1,
        "format": {
            "months": "<span color='#ffffff'><b>{}</b></span>",
            "weekdays": "<span color='#ffffff'><b>{}</b></span>",
            "today": "<span color='#ff0000'><b><u>{}</u></b></span>"
        }
    }
    },
    "network": {
        // "interface": "wlp2s0", // Optional: Force a specific interface
        "format-wifi": "  {essid} ({signalStrength}%)",
        "format-ethernet": " 🖧  ",
        "format-disconnected": "⚠  Disconnected",

        // Shortened formats when space is limited (e.g. inside a small bar)
        "format-linked": "    {ifname} (No IP)",

        // Tooltip shows detailed information on hover
        "tooltip-format": "    {ifname} via {gwaddr}\n  Frequency: {frequency}MHz\n⇣ Speed: {bandwidthDownBits} ⇡ Speed: {bandwidthUpBits}",
        "tooltip-format-wifi": "  {essid} ({signalStrength}%)\n⇣ {bandwidthDownBits} ⇡ {bandwidthUpBits}",
        "tooltip-format-ethernet": "    {ifname}\n⇣ {bandwidthDownBits} ⇡ {bandwidthUpBits}",
        "tooltip-format-disconnected": "Disconnected",

    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "   {capacity}%",
        "format-plugged": "   {capacity}%",
        "format-alt": "{time} {icon} {capacity}%",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "tooltip-format": "{capacity}% - {time}",
        "format-icons": ["", "", "", "", ""]
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon}",
        "format-bluetooth": "{icon} ()",
        "format-bluetooth-muted": "x {icon} ()",
        "format-muted": "x",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "tooltip-format": "{icon} {volume}%",
        "on-click": "pavucontrol"
    },
    "custom/power": {
      "format": "",
      "on-click": "wlogout",
      "return-type": "json",
      "escape": true
    },

    "custom/recorder": {
      "exec": "pgrep wf-recorder >/dev/null && echo REC",
      "interval": 1
    },
}
