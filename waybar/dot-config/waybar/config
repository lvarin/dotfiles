{
    "height": 10,
    "spacing": 2,

    "modules-left": ["custom/launcher", "sway/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/recorder", "sway/language", "idle_inhibitor", "sway/mode", "custom/timer","tray", "pulseaudio", "battery", "custom/power"],
    "sway/workspaces": {
	    "disable-scroll": true,
	    "format": "{icon} {name}",
      "format-icons": {
        "urgent": "",
        "focused": "",
        "default": "⃝",
        "visible": "⦾"
	    }
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "custom/timer": {
      "exec": "~/.local/bin/waybar-timer.sh",
      "interval": 1,
      "on-click": "~/.local/bin/waybar-timer.sh set",
      "on-click-right": "~/.local/bin/waybar-timer.sh pause"
    },
    "sway/language": {
      "format": "{flag}",
      "on-click": "~/.local/bin/toggle-layout"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        "icon-size": 20,
        "spacing": 7
    },
    "clock": {
        // "format": "{: %H:%M}",
        "format": "{:%b %d %a  %H:%M}",
        "tooltip-format": "{:%a - %Y %b %d - w%W  %H:%M:%S %z}"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "   {capacity}%",
        "format-plugged": "   {capacity}%",
        "format-alt": "{time} {icon} {capacity}%",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "tooltip-format": "{capacity}% - {time}",
        "format-icons": ["", "", "", "", ""]
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon}",
        "format-bluetooth": "{icon} ()",
        "format-bluetooth-muted": "x {icon} ()",
        "format-muted": "x",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "tooltip-format": "{icon} {volume}%",
        "on-click": "pavucontrol"
    },
    "custom/power": {
      "format": "",
      "on-click": "wlogout",
      "return-type": "json",
      "escape": true
    },
    "custom/launcher": {
        "format": "🐧",                 // an icon (Font Awesome magnifying glass)
        "tooltip": "App Launcher",
        "on-click": "wofi --show drun", // command to run on click
        "interval": 0                  // no need to refresh
    },
    "custom/recorder": {
      "exec": "pgrep wf-recorder >/dev/null && echo REC",
      "interval": 1
    },
}
