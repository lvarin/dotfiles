sort=-time
layer=overlay
background-color=#E0F7FA
border-color=#4DD0E1
width=500
height=500
border-size=5
border-radius=5
icons=1
max-icon-size=64
default-timeout=5000
ignore-timeout=1
font=monospace 14
text-color=#000000

[urgency=low]
border-color=#FFE082
background-color=#FFF9C4

[urgency=normal]
border-color=#4DD0E1
background-color=#E0F7FA

[urgency=high]
border-color=#F44336
background-color=#FFCDD2

[app-name=wp-vol]
layer=overlay
history=0
anchor=top-center
# Group all volume notifications together
group-by=app-name
# Hide the group-index
format=<b>%s</b>\n%b

[app-name=Spotify]
anchor=top-center

[app-name=volume group-index=0]
# Only show last notification
invisible=0
