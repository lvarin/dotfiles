{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-width": 420,
  "control-center-height": 900,
  "notification-window-width": 420,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "widgets": [
    "title#control-title",
    "dnd",
    "label#status-label",
    "calendar",
    "mpris",
    "menubar",
    "buttons-grid",
    "volume",
    "backlight",
    "notifications"
  ],
  "widget-config": {
    "title#control-title": {
      "text": "Control Center",
      "clear-all-button": false,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "label#status-label": {
      "text": "QUICK SETTINGS",
      "max-lines": 1
    },
    "calendar": {
      "format": "%A, %B %d",
      "actions": {
        "on-click-right": "close"
      }
    },
    "mpris": {
      "image-size": 72,
      "image-radius": 8,
      "blacklist": [],
      "autohide": false,
      "show-album-art": "when-available",
      "loop-carousel": false
    },
    "menubar": {
      "menu#power": {
        "label": "Power",
        "position": "right",
        "actions": [
          {
            "label": "Lock screen",
            "command": "swaylock"
          },
          {
            "label": "Log out",
            "command": "swaymsg exit"
          },
          {
            "label": "Reboot…",
            "command": "systemctl reboot"
          },
          {
            "label": "Shut down…",
            "command": "systemctl poweroff"
          }
        ]
      },
      "buttons#tools": {
        "position": "left",
        "actions": [
          {
            "label": "Terminal",
            "command": "foot"
          },
          {
            "label": "File manager",
            "command": "thunar"
          },
          {
            "label": "Screenshot",
            "command": "grim -g \"$(slurp)\" - | wl-copy"
          }
        ]
      }
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰤨 Wi-Fi",
          "type": "toggle",
          "active": true,
          "command": "sh -c 'if [ \"$SWAYNC_TOGGLE_STATE\" = true ]; then nmcli radio wifi on; else nmcli radio wifi off; fi'",
          "update-command": "sh -c 'nmcli radio wifi | grep -q enabled && echo true || echo false'"
        },
        {
          "label": "󰂯 Bluetooth",
          "type": "toggle",
          "active": true,
          "command": "sh -c 'if [ \"$SWAYNC_TOGGLE_STATE\" = true ]; then rfkill unblock bluetooth; else rfkill block bluetooth; fi'",
          "update-command": "sh -c 'rfkill list bluetooth | grep -q \"Soft blocked: no\" && echo true || echo false'"
        },
        {
          "label": "󰖔 Night light",
          "command": "sh -c 'notify-send \"Night light\" \"Connect this button to your preferred Wayland night-light tool.\"'"
        },
        {
          "label": "󰍹 Display",
          "command": "sh -c 'swaymsg -t get_outputs'"
        },
        {
          "label": "󰕾 Mute",
          "type": "toggle",
          "active": false,
          "command": "sh -c 'pactl set-sink-mute @DEFAULT_SINK@ \"$SWAYNC_TOGGLE_STATE\"'",
          "update-command": "sh -c 'pactl get-sink-mute @DEFAULT_SINK@ | grep -q yes && echo true || echo false'"
        },
        {
          "label": "󰌾 Lock",
          "command": "swaylock"
        }
      ]
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false,
      "show-per-app-icon": true
    },
    "backlight": {
      "label": "󰃠",
      "device": "intel_backlight",
      "min": 5
    },
    "notifications": {
      "vexpand": true
    }
  }
}
