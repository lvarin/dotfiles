{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-width": 420,
  "control-center-height": 900,
  "notification-window-width": 420,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "widgets": [
    "inhibitors",
    "dnd",
    "title",
    /* "mpris", */
    /* "menubar", */
    "buttons-grid",
    "volume",
    "backlight",
    "notifications"
  ],
  "widget-config": {
    "inhibitors": {
      "text": "Inhibitors",
      "button-text": "Clear All",
      "clear-all-button": true
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "title": {
      "text": "QUICK SETTINGS",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "mpris": {
      "image-size": 70,
      "image-radius": 8,
      "blacklist": [],
      "autohide": false,
      "show-album-art": "never",
      "loop-carousel": false
    },
    "menubar": {
      "menu#power": {
        "label": "Power",
        "position": "right",
        "actions": [
          {
            "label": "Lock screen",
            "command": "swaylock"
          },
          {
            "label": "Log out",
            "command": "swaymsg exit"
          },
          {
            "label": "Reboot…",
            "command": "systemctl reboot"
          },
          {
            "label": "Shut down…",
            "command": "systemctl poweroff"
          }
        ]
      },
      "buttons#tools": {
        "position": "left",
        "actions": [
          {
            "label": "Terminal",
            "command": "kitty"
          },
          {
            "label": "File manager",
            "command": "nautilus"
          },
          {
            "label": "Screenshot",
            "command": "grim -g \"$(slurp)\" - | wl-copy"
          }
        ]
      }
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "x Mute",
          "type": "toggle",
          "active": false,
          "command": "sh -c 'pactl set-sink-mute @DEFAULT_SINK@ \"$SWAYNC_TOGGLE_STATE\"'",
          "update-command": "sh -c 'pactl get-sink-mute @DEFAULT_SINK@ | grep -q yes && echo true || echo false'"
        },
        {
          "label": " VPN",
          "type": "toggle",
          "command": "vpn-on-off.sh",
	  "update-command": "sh -c 'nmcli connection show --active | grep staff-remote.csc.fi && echo true || echo false'"
        }
      ]
    },
    "volume": {
      "label": "",
      "show-per-app": false,
      "show-per-app-icon": true
    },
    "backlight": {
      "label": "☀ ",
      "device": "amdgpu_bl1",
      "min": 5
    },
    "notifications": {
      "vexpand": true
    }
  }
}
